{
  "name": "invicto-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --manifest && vite build --ssr src/main.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "verify:production": "node scripts/verify-production.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "audit:desktop": "lighthouse http://127.0.0.1:4173/products/traceq --chrome-flags=--headless --preset=desktop --output=html --output=json --output-path=./lighthouse-desktop",
    "audit:mobile": "lighthouse http://127.0.0.1:4173/products/traceq --chrome-flags=--headless --output=html --output=json --output-path=./lighthouse-mobile"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lighthouse": "^13.5.0",
    "purgecss": "^8.0.0",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
